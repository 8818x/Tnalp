PORT=9002
MONGODB_URI=mongodb://localhost:27017/tnalp
# generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
# Optional locally (uploads go to local disk). Set real values on hosting
# (e.g. Render) so uploads persist in Cloudinary instead of an ephemeral disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
